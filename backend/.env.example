# Copy to .env and fill in. Never commit .env.

# SerpApi — https://serpapi.com/users/sign_up (250 searches/month on free plan)
# If unset, the backend runs in FIXTURE mode with synthetic responses.
SERPAPI_API_KEY=

# Force fixture mode even when a key is present (1 = fixtures only)
TRIPPILOT_FIXTURES=0

# Mistral parses natural-language intake into a typed draft; it never schedules
# routes, prices, or bookings. Ministral 8B is the default: current, open-weight
# (Apache 2.0), and covered by the free Experiment tier on most accounts.
LLM_PROVIDER=mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-latest

# Infrastructure. Without a reachable Redis, an in-process cache is used.
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://trippilot:trippilot@localhost:5432/trippilot

# Server
TRIPPILOT_HOST=0.0.0.0
TRIPPILOT_PORT=8000
TRIPPILOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Per-trip SerpApi search budget (hard cap on live searches per plan run)
TRIPPILOT_SEARCH_BUDGET=40
